{
  "name": "@jslib/emitter",
  "version": "0.1.2",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno test --watch",
    "test": "deno test",
    "lint": "deno lint --fix",
    "release": {
      "command": "deno publish --allow-dirty",
      "dependencies": ["test", "lint"]
    }
  },
  "license": "MIT",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@1",
    "@/": "./src/"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "test": {
    "include": ["./tests/**/*.ts"]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "auto"
}
